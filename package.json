{
  "name": "myantigravity",
  "displayName": "MyAntigravity",
  "description": "Agentic IDE powered by Gemini",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "antigravity-explorer",
          "title": "MyAntigravity",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "antigravity-explorer": [
        {
          "type": "webview",
          "id": "antigravity.chatView",
          "name": "Agent Manager"
        }
      ]
    },
    "commands": [
      {
        "command": "myantigravity.helloWorld",
        "title": "Hello World"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.104.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.52.0",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}