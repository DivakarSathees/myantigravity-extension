{
  "name": "neuralstack",
  "displayName": "NeuralStack",
  "description": "Agentic IDE powered by Gemini",
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "neuralstack-explorer",
          "title": "NeuralStack",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "neuralstack-explorer": [
        {
          "type": "webview",
          "id": "neuralstack.chatView",
          "name": "Agent Manager"
        }
      ]
    },
    "commands": [
      {
        "command": "neuralstack.helloWorld",
        "title": "Hello World"
      }
    ],
    "configuration": {
      "title": "NeuralStack",
      "properties": {
        "neuralstack.proxyBaseUrl": {
          "type": "string",
          "default": "",
          "description": "Backend base URL (leave empty to use webview proxy)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.104.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.52.0",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}